# --- Servidor ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=/api

# --- Base de datos ----------------------------------------------------------
# Local:   postgresql://usuario:password@localhost:5432/parkit_dev
# Railway: la plataforma inyecta DATABASE_URL al vincular el servicio Postgres.
DATABASE_URL=postgresql://usuario:password@localhost:5432/parkit_dev
# En Railway/produccion poner true (usa SSL sin validar el CA del proveedor).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Autenticacion ----------------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
