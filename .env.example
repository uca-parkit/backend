# --- Servidor ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=/api

# --- Base de datos ----------------------------------------------------------
# Opcional por ahora: sin DATABASE_URL la API arranca en modo sin base y solo
# acepta el login admin@gmail.com / admin123 (el resto de endpoints responde 503).
# Neon: postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

DATABASE_URL="postgresql://neondb_owner:npg_iknKLoPg5t2B@ep-rough-snow-b53z65co.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://neondb_owner:npg_iknKLoPg5t2B@ep-rough-snow-b53z65co-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Con Neon/Railway/produccion poner true (usa SSL sin validar el CA del proveedor).
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- Autenticacion ----------------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
